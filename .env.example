# Token exigido pelas rotas de escrita do api.php (update_item, add_log,
# add_despachante, etc — ver authenticateRequest()). deploy.js/server.js
# geram config.js a partir deste valor (npm start / node deploy.js); o
# frontend (app.js) lê de CONFIG.API_TOKEN. Nunca hardcoded no código-fonte.
# Para gerar um token seguro: php -r "echo bin2hex(random_bytes(32));"
API_TOKEN=__coloque_o_token_aqui__

# Chave usada pelo api.php para autenticar no proxy de bipagem quando o
# operador não tem token salvo no localStorage do navegador (ver popup ⚙️
# de configurações). Também pode ser lida de ../bipagem-config.php fora
# da pasta pública — ver comentário em api.php.
BIPAGEM_API_KEY=__coloque_a_chave_aqui__
